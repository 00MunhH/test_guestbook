# Kakao OAuth 2.0 credentials (https://developers.kakao.com)
KAKAO_REST_API_KEY=api-key-value
KAKAO_CLIENT_SECRET=your_kakao_client_secret_optional
KAKAO_REDIRECT_URI=http://localhost:8000/auth/kakao/callback

# Session signing secret (use a long random string in production)
SESSION_SECRET_KEY=change-me-to-a-long-random-secret

# SQLite database URL
DATABASE_URL=sqlite:///./guestbook.db

# 최초 관리자로 지정할 카카오 사용자 ID (쉼표로 여러 명 지정 가능)
# 여기 적힌 ID로 로그인하면 자동으로 관리자 권한이 부여됩니다.
ADMIN_KAKAO_IDS=
