{
  "family": "guestbook-app02",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/guestbookApp02TaskRole",
  "volumes": [
    {
      "name": "efs-data",
      "efsVolumeConfiguration": {
        "fileSystemId": "<EFS_FILE_SYSTEM_ID>",
        "transitEncryption": "ENABLED",
        "authorizationConfig": {
          "accessPointId": "<EFS_ACCESS_POINT_ID>",
          "iam": "ENABLED"
        }
      }
    }
  ],
  "containerDefinitions": [
    {
      "name": "web",
      "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/guestbook-app02:latest",
      "essential": true,
      "portMappings": [
        { "containerPort": 8000, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "DATABASE_URL", "value": "sqlite:////mnt/data/guestbook.db" },
        { "name": "UPLOAD_DIR", "value": "/mnt/data/uploads" },
        { "name": "KAKAO_REDIRECT_URI", "value": "https://<ALB_DOMAIN>/auth/kakao/callback" },
        { "name": "ADMIN_KAKAO_IDS", "value": "" },
        { "name": "ADMIN_USERNAME", "value": "admin" }
      ],
      "secrets": [
        { "name": "KAKAO_REST_API_KEY", "valueFrom": "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:parameter/guestbook/KAKAO_REST_API_KEY" },
        { "name": "KAKAO_CLIENT_SECRET", "valueFrom": "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:parameter/guestbook/KAKAO_CLIENT_SECRET" },
        { "name": "SESSION_SECRET_KEY", "valueFrom": "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:parameter/guestbook/SESSION_SECRET_KEY" },
        { "name": "ADMIN_PASSWORD", "valueFrom": "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:parameter/guestbook/ADMIN_PASSWORD" }
      ],
      "mountPoints": [
        { "sourceVolume": "efs-data", "containerPath": "/mnt/data", "readOnly": false }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/guestbook-app02",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "web"
        }
      }
    }
  ]
}
