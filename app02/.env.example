# Kakao OAuth 2.0 credentials (https://developers.kakao.com)
KAKAO_REST_API_KEY=your_kakao_rest_api_key
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://<ALB_도메인>/auth/kakao/callback

# Session signing secret (use a long random string in production)
SESSION_SECRET_KEY=change-me-to-a-long-random-secret

# EFS 마운트 경로 기준 (ECS 운영 값). 로컬 개발 시에는 sqlite:///./guestbook.db 등으로.
DATABASE_URL=sqlite:////mnt/data/guestbook.db
UPLOAD_DIR=/mnt/data/uploads

# 최초 관리자 카카오 ID (쉼표 구분)
ADMIN_KAKAO_IDS=

# 카카오 없이 로그인하는 기본 관리자 계정
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
