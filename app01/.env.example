# Kakao OAuth 2.0 credentials (https://developers.kakao.com)
KAKAO_REST_API_KEY=your_kakao_rest_api_key
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://<EC2_퍼블릭_IP>:8000/auth/kakao/callback

# Session signing secret (use a long random string in production)
SESSION_SECRET_KEY=change-me-to-a-long-random-secret

# 컨테이너 내부 데이터 경로(= EFS bind mount 지점). 보통 그대로 둔다.
DATABASE_URL=sqlite:////data/guestbook.db
UPLOAD_DIR=/data/uploads

# 최초 관리자 카카오 ID (쉼표 구분)
ADMIN_KAKAO_IDS=

# 카카오 없이 로그인하는 기본 관리자 계정
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# docker-compose가 bind mount할 호스트 경로.
# EC2 운영 시 EFS 마운트 경로로: EFS_DATA_DIR=/mnt/efs/guestbook
# (docker compose 실행 시 환경변수로 넘기거나 여기에 적어도 됨)
# EFS_DATA_DIR=/mnt/efs/guestbook
