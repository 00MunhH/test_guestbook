# Kakao OAuth 2.0
KAKAO_REST_API_KEY=your_kakao_rest_api_key
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://<ALB_도메인>/auth/kakao/callback

# 세션 서명 키
SESSION_SECRET_KEY=change-me-to-a-long-random-secret

# DB (RDS PostgreSQL). 로컬 compose는 db 서비스로 자동 주입됨
DATABASE_URL=postgresql+psycopg://guestbook:guestbook@localhost:5432/guestbook

# 실시간(SSE) 브로커: Redis (ElastiCache)
REDIS_URL=redis://localhost:6379/0

# 파일 업로드: S3 (운영은 ECS Task Role로 자격증명 주입 권장 → 키는 비움)
S3_BUCKET=guestbook
AWS_REGION=ap-northeast-2
# 로컬 MinIO 사용 시 엔드포인트/키 지정, 실제 AWS면 비움
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 관리자
ADMIN_KAKAO_IDS=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
